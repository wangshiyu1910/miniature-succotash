# ---------- 2. 模型间 AUC 差值的 bootstrap CI ----------
# 同一重抽样索引下同时评估两个模型，差值 CI 比分别看两个 CI 是否重叠更严谨
model_pairs <- combn(model_names, 2, simplify = FALSE)

boot_auc_diff <- function(pred_a, pred_b, y_true, R = 2000, seed = 2024) {
  set.seed(seed)
  n <- length(y_true)
  auc_a <- auc(roc(y_true, pred_a, quiet = TRUE))
  auc_b <- auc(roc(y_true, pred_b, quiet = TRUE))
  point_diff <- as.numeric(auc_a - auc_b)
  diffs <- numeric(R)
  for (r in 1:R) {
    idx <- sample.int(n, n, replace = TRUE)
    y_r <- y_true[idx]
    if (length(unique(y_r)) < 2) { diffs[r] <- NA; next }
    a_r <- tryCatch(as.numeric(auc(roc(y_r, pred_a[idx], quiet = TRUE))), error = function(e) NA)
    b_r <- tryCatch(as.numeric(auc(roc(y_r, pred_b[idx], quiet = TRUE))), error = function(e) NA)
    diffs[r] <- a_r - b_r
  }
  ci <- quantile(diffs, c(0.025, 0.975), na.rm = TRUE)
  data.frame(Model_A = NA, Model_B = NA, AUC_A = as.numeric(auc_a), AUC_B = as.numeric(auc_b),
             Diff = point_diff, Lower = ci[1], Upper = ci[2])
}

