# ==================== 2. outc_cod（结局代码）插补 ====================
cat("\n========== outc_cod 插补 ==========\n")

# 2.1 基于严重不良反应推断结局
data <- data %>%
  mutate(
    # 根据 PT（不良反应术语）推断结局严重性
    inferred_severity = case_when(
      # 死亡相关术语
      grepl("death|die|fatal|lethal|dead|expired|moribund", 
            pt, ignore.case = TRUE) ~ "DE",
      # 危及生命相关术语
      grepl("life threatening|life-threatening|endangering", 
            pt, ignore.case = TRUE) ~ "LT",
      # 住院相关术语
      grepl("hospitali|admission|inpatient", 
            pt, ignore.case = TRUE) ~ "HO",
      # 残疾相关术语
      grepl("disabilit|disable|handicap|permanent injury", 
            pt, ignore.case = TRUE) ~ "CA",
      # 先天性异常
      grepl("congenital|birth defect|malformation|anomaly", 
            pt, ignore.case = TRUE) ~ "RI",
      # 需要干预
      grepl("intervention|required|prevent|damage", 
            pt, ignore.case = TRUE) ~ "DS",
      TRUE ~ NA_character_
    )
  )

# 2.2 根据药物名称推断结局（艾司西酞普兰特定）
data <- data %>%
  mutate(
    drug_related_severity = case_when(
      # 自杀相关（SSRI 类药物的重要安全性事件）
      grepl("suicid|self harm|self-injury|overdose", 
            pt, ignore.case = TRUE) ~ "DE",
      # 血清素综合征
      grepl("serotonin syndrome|serotonin toxicity", 
            pt, ignore.case = TRUE) ~ "HO",
      # 出血事件
      grepl("bleeding|haemorrhage|hemorrhage", 
            pt, ignore.case = TRUE) ~ "HO",
      TRUE ~ NA_character_
    )
  )

# 2.3 基于不良反应的数量推断
data <- data %>%
  group_by(primaryid) %>%
  mutate(
    # 每个报告的不良反应数量
    reac_count = n(),
    # 多不良反应可能预示严重结局
    inferred_by_count = ifelse(reac_count >= 5, "OT", NA_character_)
  ) %>%
  ungroup()

# 2.4 综合插补 outc_cod
data <- data %>%
  mutate(
    # 优先使用原始值
    outc_cod_imputed = case_when(
      !is.na(outc_cod) ~ outc_cod,
      !is.na(inferred_severity) ~ inferred_severity,
      !is.na(drug_related_severity) ~ drug_related_severity,
      !is.na(inferred_by_count) ~ inferred_by_count,
      # 默认：其他严重（OT）或非严重
      TRUE ~ "OT"  # 保守估计为其他严重
    ),
    
    # 严重结局标志
    serious_outcome = case_when(
      outc_cod_imputed %in% c("DE", "LT", "HO", "CA", "RI", "DS") ~ 1,
      outc_cod_imputed %in% c("OT", "Other") ~ 0,
      TRUE ~ 0
    ),
    
    # 结局分类
    outcome_category = case_when(
      outc_cod_imputed == "DE" ~ "死亡",
      outc_cod_imputed == "LT" ~ "危及生命",
      outc_cod_imputed == "HO" ~ "住院",
      outc_cod_imputed == "CA" ~ "残疾",
      outc_cod_imputed == "RI" ~ "先天异常",
      outc_cod_imputed == "DS" ~ "需要干预",
      outc_cod_imputed == "OT" ~ "其他严重",
      TRUE ~ "未知"
    ),
    
    # 插补标志
    outc_imputed_flag = is.na(outc_cod)
  )

# 2.5 查看插补结果
cat("\noutc_cod 插补结果:\n")
cat("插补数量:", sum(data$outc_imputed_flag), "\n")
cat("插补后分布:\n")
print(table(data$outc_cod_imputed, useNA = "ifany"))

# ==================== 3. indi_pt（适应症）插补 ====================
cat("\n========== indi_pt 插补 ==========\n")

# 3.1 基于药物名称推断适应症（艾司西酞普兰常见适应症）
data <- data %>%
  mutate(
    # 从药物名称推断
    indi_from_drug = case_when(
      grepl("escitalopram|lexapro", drugname, ignore.case = TRUE) ~ 
        "Major depressive disorder",
      TRUE ~ NA_character_
    ),
    
    # 从不良反应反推适应症
    indi_from_reaction = case_when(
      # 抑郁相关不良反应
      grepl("depression|depressed mood|suicidal|self harm", 
            pt, ignore.case = TRUE) ~ "Depression",
      # 焦虑相关
      grepl("anxiety|panic|agitation|nervousness", 
            pt, ignore.case = TRUE) ~ "Anxiety disorder",
      # 强迫症相关
      grepl("obsessive|compulsive|ocd", 
            pt, ignore.case = TRUE) ~ "OCD",
      # 惊恐障碍
      grepl("panic attack|panic disorder", 
            pt, ignore.case = TRUE) ~ "Panic disorder",
      TRUE ~ NA_character_
    )
  )

# 3.2 使用同一报告中的其他信息
data <- data %>%
  group_by(primaryid) %>%
  mutate(
    # 同一报告中的其他适应症（如果有）
    other_indi = first(indi_pt[!is.na(indi_pt)]),
    # 同一报告中的不良反应推断
    common_indi = case_when(
      any(grepl("depression|depressed", pt, ignore.case = TRUE)) ~ "Depression",
      any(grepl("anxiety|panic", pt, ignore.case = TRUE)) ~ "Anxiety",
      TRUE ~ NA_character_
    )
  ) %>%
  ungroup()

# 3.3 综合插补 indi_pt
# 获取最常见的适应症作为默认值
top_indi <- names(sort(table(data$indi_pt), decreasing = TRUE))[1]

data <- data %>%
  mutate(
    indi_pt_imputed = case_when(
      # 优先使用原始值
      !is.na(indi_pt) ~ indi_pt,
      # 从药物名称推断
      !is.na(indi_from_drug) ~ indi_from_drug,
      # 从不良反应推断
      !is.na(indi_from_reaction) ~ indi_from_reaction,
      # 同一报告中的其他适应症
      !is.na(other_indi) ~ other_indi,
      # 常见适应症推断
      !is.na(common_indi) ~ common_indi,
      # 默认值（最常见的适应症）
      TRUE ~ top_indi
    ),
    
    # 适应症分类（简化）
    indi_category = case_when(
      grepl("depression|depressive|major depressive", 
            indi_pt_imputed, ignore.case = TRUE) ~ "抑郁症",
      grepl("anxiety|panic|generalized anxiety|social anxiety", 
            indi_pt_imputed, ignore.case = TRUE) ~ "焦虑症",
      grepl("ocd|obsessive|compulsive", 
            indi_pt_imputed, ignore.case = TRUE) ~ "强迫症",
      TRUE ~ "其他"
    ),
    
    # 插补标志
    indi_imputed_flag = is.na(indi_pt)
  )

