# 计算性能指标
calculate_metrics <- function(pred_prob, y_true, threshold = 0.5) {
  pred_class <- ifelse(pred_prob >= threshold, 1, 0)
  
  cm <- table(Predicted = pred_class, Actual = y_true)
  
  accuracy <- sum(diag(cm)) / sum(cm)
  precision <- ifelse(sum(pred_class == 1) > 0, cm[2,2] / sum(pred_class == 1), NA)
  recall <- ifelse(sum(y_true == 1) > 0, cm[2,2] / sum(y_true == 1), NA)
  specificity <- ifelse(sum(y_true == 0) > 0, cm[1,1] / sum(y_true == 0), NA)
  f1 <- ifelse(!is.na(precision) & !is.na(recall) & (precision + recall) > 0, 
               2 * precision * recall / (precision + recall), NA)
  
  balanced_accuracy <- (recall + specificity) / 2
  
  roc_obj <- roc(y_true, pred_prob)
  auc_value <- auc(roc_obj)
  
  return(list(
    accuracy = accuracy,
    precision = precision,
    recall = recall,
    specificity = specificity,
    f1 = f1,
    balanced_accuracy = balanced_accuracy,
    auc = as.numeric(auc_value),
    confusion_matrix = cm,
    roc_obj = roc_obj
  ))
}

