# ==================== 完整的 FAERS 数据处理 ====================
library(readxl)
library(dplyr)
library(tidyr)
library(writexl)

# 1. 读取数据（先全部读取为文本，避免自动转换错误）
cat("读取数据...\n")
data <- read_excel("Escitalopram_final.xlsx", col_types = "text")

cat("数据维度:", dim(data), "\n")

# 2. 转换数值型变量
cat("\n转换数值型变量...\n")
data <- data %>%
  mutate(
    # 年龄相关
    age = as.numeric(age),
    age_cod = as.character(age_cod),
    
    # 体重相关
    wt = as.numeric(wt),
    wt_cod = as.character(wt_cod),
    
    # ID 变量
    primaryid = as.character(primaryid),
    caseid = as.character(caseid)
  )

# 3. 年龄处理
cat("\n处理年龄...\n")
data <- data %>%
  mutate(
    # 年龄单位标准化
    age_unit = case_when(
      age_cod %in% c("YR", "YEAR", "Y") ~ "YEAR",
      age_cod %in% c("MON", "MONTH", "M") ~ "MONTH",
      age_cod %in% c("WK", "WEEK", "W") ~ "WEEK",
      age_cod %in% c("DAY", "D") ~ "DAY",
      age_cod %in% c("DEC", "DECADE") ~ "DECADE",
      is.na(age_cod) & !is.na(age) ~ "UNKNOWN",
      TRUE ~ NA_character_
    ),
    
    # 转换为年
    age_years = case_when(
      age_unit == "YEAR" ~ age,
      age_unit == "MONTH" ~ age / 12,
      age_unit == "WEEK" ~ age / 52.14,
      age_unit == "DAY" ~ age / 365.25,
      age_unit == "DECADE" ~ age * 10,
      age_unit == "UNKNOWN" & age > 150 ~ age / 10,
      age_unit == "UNKNOWN" & age > 100 & age <= 150 ~ age,
      age_unit == "UNKNOWN" & age > 20 & age <= 100 ~ age,
      age_unit == "UNKNOWN" & age > 2 & age <= 20 ~ age,
      age_unit == "UNKNOWN" & age <= 2 ~ age * 12,
      TRUE ~ NA_real_
    ),
    
    # 年龄分组
    age_group = case_when(
      age_years < 18 ~ "儿童 (<18岁)",
      age_years >= 18 & age_years < 45 ~ "青年 (18-44岁)",
      age_years >= 45 & age_years < 65 ~ "中年 (45-64岁)",
      age_years >= 65 & age_years < 75 ~ "老年 (65-74岁)",
      age_years >= 75 ~ "高龄 (≥75岁)",
      TRUE ~ "未知"
    )
  )

# 4. 性别处理
cat("\n处理性别...\n")
data <- data %>%
  mutate(
    sex_clean = case_when(
      toupper(sex) %in% c("M", "MALE", "1") ~ "M",
      toupper(sex) %in% c("F", "FEMALE", "2") ~ "F",
      toupper(sex) %in% c("U", "UNKNOWN", "NS", "9") ~ "U",
      TRUE ~ NA_character_
    ),
    sex_code = case_when(
      sex_clean == "M" ~ 1,
      sex_clean == "F" ~ 0,
      TRUE ~ NA_real_
    )
  )

# 5. 体重处理
cat("\n处理体重...\n")
data <- data %>%
  mutate(
    # 体重单位标准化
    wt_unit = case_when(
      toupper(wt_cod) %in% c("KGS", "KG", "KILOGRAM") ~ "KG",
      toupper(wt_cod) %in% c("LBS", "LB", "POUND") ~ "LB",
      is.na(wt_cod) & !is.na(wt) ~ "UNKNOWN",
      TRUE ~ NA_character_
    ),
    
    # 转换为公斤
    wt_kg = case_when(
      wt_unit == "KG" ~ wt,
      wt_unit == "LB" ~ wt * 0.453592,
      wt_unit == "UNKNOWN" & wt < 300 ~ wt,
      wt_unit == "UNKNOWN" & wt >= 300 ~ wt * 0.453592,
      TRUE ~ NA_real_
    ),
    
    # 体重分组
    wt_group = case_when(
      wt_kg < 50 ~ "体重过轻 (<50kg)",
      wt_kg >= 50 & wt_kg < 70 ~ "正常体重 (50-70kg)",
      wt_kg >= 70 & wt_kg < 90 ~ "超重 (70-90kg)",
      wt_kg >= 90 ~ "肥胖 (≥90kg)",
      TRUE ~ "未知"
    )
  )

# 6. 简单插补
cat("\n进行缺失值插补...\n")

# 按性别分层的年龄中位数
age_median_m <- median(data$age_years[data$sex_clean == "M"], na.rm = TRUE)
age_median_f <- median(data$age_years[data$sex_clean == "F"], na.rm = TRUE)
age_median_all <- median(data$age_years, na.rm = TRUE)

# 按性别分层的体重中位数
wt_median_m <- median(data$wt_kg[data$sex_clean == "M"], na.rm = TRUE)
wt_median_f <- median(data$wt_kg[data$sex_clean == "F"], na.rm = TRUE)
wt_median_all <- median(data$wt_kg, na.rm = TRUE)

data <- data %>%
  mutate(
    # 年龄插补
    age_imputed = case_when(
      !is.na(age_years) ~ age_years,
      sex_clean == "M" ~ age_median_m,
      sex_clean == "F" ~ age_median_f,
      TRUE ~ age_median_all
    ),
    
    # 性别插补（使用众数）
    sex_imputed = case_when(
      !is.na(sex_clean) ~ sex_clean,
      TRUE ~ names(sort(table(sex_clean), decreasing = TRUE))[1]
    ),
    
    # 体重插补
    wt_imputed = case_when(
      !is.na(wt_kg) ~ wt_kg,
      sex_clean == "M" ~ wt_median_m,
      sex_clean == "F" ~ wt_median_f,
      TRUE ~ wt_median_all
    ),
    
    # 插补标志
    age_missing = is.na(age_years),
    sex_missing = is.na(sex_clean),
    wt_missing = is.na(wt_kg)
  )

# 7. 查看处理结果
cat("\n========== 处理结果 ==========\n")
cat("数据维度:", dim(data), "\n")
cat("\n年龄统计:\n")
cat("  范围:", range(data$age_years, na.rm = TRUE), "\n")
cat("  缺失率:", mean(is.na(data$age_years)) * 100, "%\n")
cat("  插补后缺失率:", mean(data$age_missing) * 100, "%\n")

cat("\n性别统计:\n")
print(table(data$sex_clean, useNA = "ifany"))
cat("  缺失率:", mean(is.na(data$sex_clean)) * 100, "%\n")

cat("\n体重统计:\n")
cat("  范围:", range(data$wt_kg, na.rm = TRUE), "\n")
cat("  缺失率:", mean(is.na(data$wt_kg)) * 100, "%\n")

# 8. 创建分析数据集
cat("\n创建分析数据集...\n")
analysis_data <- data %>%
  select(
    primaryid, caseid,
    age_years, age_imputed, age_group, age_missing,
    sex_clean, sex_imputed, sex_code, sex_missing,
    wt_kg, wt_imputed, wt_group, wt_missing,
    everything()
  )

# 9. 保存结果
cat("\n保存结果...\n")
write_xlsx(analysis_data, "Escitalopram_FAERS_processed_fixed.xlsx")
cat("✓ 已保存: Escitalopram_FAERS_processed_fixed.xlsx\n")

# 保存一份 CSV 备份
write.csv(analysis_data, "Escitalopram_FAERS_processed_fixed.csv", row.names = FALSE)
cat("✓ 已保存: Escitalopram_FAERS_processed_fixed.csv\n")

# 10. 生成简单报告
cat("\n========== 处理报告 ==========\n")
cat("1. 数据类型问题已修复\n")
cat("2. 年龄单位已标准化为年\n")
cat("3. 性别编码已标准化为 M/F\n")
cat("4. 体重单位已标准化为 kg\n")
cat("5. 缺失值已按性别分层插补\n")
cat("\n最终数据可用于回归分析\n")


