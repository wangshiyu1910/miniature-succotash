calibration_plot_data <- function(pred_prob, y_true, n_bins = 10) {
  df <- data.frame(pred = pred_prob, true = y_true)
  df$bin <- cut(df$pred, breaks = seq(0, 1, length.out = n_bins + 1), 
                include.lowest = TRUE)
  
  cal_df <- df %>%
    group_by(bin) %>%
    summarise(
      mean_pred = mean(pred),
      mean_true = mean(true),
      n = n(),
      se = sqrt(mean_true * (1 - mean_true) / n)
    ) %>%
    filter(n > 0)
  
  return(cal_df)
}

