cat("\n--- 正在计算 JADER 重训练模型的置信区间 (Bootstrap R=2000) ---\n")

boot_metrics_ci <- function(pred_prob, y_true, threshold = 0.5, R = 2000, seed = 2024) {
  set.seed(seed)
  metric_fun <- function(d, idx) {
    p <- d$pred[idx]; y <- d$y[idx]
    if(length(unique(y)) < 2) return(rep(NA, 7))
    cls <- ifelse(p >= threshold, 1, 0)
    tp <- sum(cls == 1 & y == 1); fp <- sum(cls == 1 & y == 0)
    tn <- sum(cls == 0 & y == 0); fn <- sum(cls == 0 & y == 1)
    acc <- (tp + tn) / length(y)
    sens <- ifelse((tp + fn) > 0, tp / (tp + fn), NA)
    spec <- ifelse((tn + fp) > 0, tn / (tn + fp), NA)
    prec <- ifelse((tp + fp) > 0, tp / (tp + fp), NA)
    f1 <- ifelse(!is.na(prec) & !is.na(sens) & (prec + sens) > 0, 2 * prec * sens / (prec + sens), NA)
    auc_v <- tryCatch(as.numeric(auc(roc(y, p, quiet = TRUE))), error = function(e) NA)
    pr_v <- tryCatch(PRROC::pr.curve(scores.class0 = p[y == 1], scores.class1 = p[y == 0], curve = FALSE)$auc.integral, error = function(e) NA)
    c(Accuracy = acc, Sensitivity = sens, Specificity = spec, Precision = prec, F1 = f1, AUC = auc_v, PR_AUC = pr_v)
  }
  d <- data.frame(pred = pred_prob, y = y_true)
  b <- boot(d, metric_fun, R = R)
  ci <- apply(b$t, 2, function(x) quantile(x, c(0.025, 0.975), na.rm = TRUE))
  point <- metric_fun(d, 1:length(y_true))
  data.frame(Dataset = "JADER_Retrained", Model = "XGBoost", Metric = names(point), 
             Point = as.numeric(point), Lower = ci[1, ], Upper = ci[2, ], row.names = NULL)
}

