cat("\n--- 正在计算校准度 ---\n")

# 1. 计算校准截距 (C) 和 校准斜率 (Slope) 及 95% CI
cal_obj <- val.prob.ci.2(p = best_pred_prob, y = y_true, 
                         smooth = "loess", legendloc = FALSE, 
                         CL.smooth = TRUE, dostats = TRUE)

# 将 val.prob.ci.2 的结果展开为向量，方便模糊匹配
cal_vec <- unlist(cal_obj)

# 使用 grep 寻找包含 "Intercept" 或 "Slope" 的元素名
# 并区分点估计（不包含 lower/upper 的）和 CI
intercept_idx <- grep("Intercept", names(cal_vec), ignore.case = TRUE)
slope_idx <- grep("Slope", names(cal_vec), ignore.case = TRUE)

# 提取截距的点估计、下限和上限
c_point <- cal_vec[intercept_idx[1]]
c_lower <- cal_vec[grep("lower", names(cal_vec)[intercept_idx], ignore.case = TRUE)]
c_upper <- cal_vec[grep("upper", names(cal_vec)[intercept_idx], ignore.case = TRUE)]

# 提取斜率的点估计、下限和上限
s_point <- cal_vec[slope_idx[1]]
s_lower <- cal_vec[grep("lower", names(cal_vec)[slope_idx], ignore.case = TRUE)]
s_upper <- cal_vec[grep("upper", names(cal_vec)[slope_idx], ignore.case = TRUE)]

# 如果上述模糊提取失败（返回 empty），我们可以使用备选方案（见下方第三步）

# 如果有找到值，则构建数据框
if (length(c_point) > 0 && length(s_point) > 0) {
  cal_table <- data.frame(
    Metric = c("Calibration Intercept", "Calibration Slope"),
    Estimate = c(as.numeric(c_point[1]), as.numeric(s_point[1])),
    Lower_95CI = c(as.numeric(c_lower[1]), as.numeric(s_lower[1])),
    Upper_95CI = c(as.numeric(c_upper[1]), as.numeric(s_upper[1]))
  )
  print(cal_table)
  write.csv(cal_table, "faers_calibration_stats.csv", row.names = FALSE)
}
# ============================================================================
# 自建稳健版校准度计算（不依赖 CalibrationCurves 包）
# ============================================================================

# 1. 计算校准截距 (Calibration-in-the-large) 和 斜率 (Slope)
# 原理：将预测概率进行 logit 变换后作为自变量，真实标签为因变量做 logistic 回归
lp <- log(best_pred_prob / (1 - best_pred_prob))
# 避免极端值引起的 Inf
lp[is.infinite(lp)] <- ifelse(lp[is.infinite(lp)] > 0, 10, -10) 

cal_glm <- glm(y_test ~ lp, family = binomial)
summary_cal <- summary(cal_glm)$coefficients

# 提取截距及 95% CI
cal_intercept <- summary_cal["(Intercept)", 1]
cal_intercept_lower <- cal_intercept - 1.96 * summary_cal["(Intercept)", 2]
cal_intercept_upper <- cal_intercept + 1.96 * summary_cal["(Intercept)", 2]

# 提取斜率及 95% CI
cal_slope <- summary_cal["lp", 1]
cal_slope_lower <- cal_slope - 1.96 * summary_cal["lp", 2]
cal_slope_upper <- cal_slope + 1.96 * summary_cal["lp", 2]

# 整理成表格
cal_table <- data.frame(
  Metric = c("Calibration Intercept", "Calibration Slope"),
  Estimate = c(cal_intercept, cal_slope),
  Lower_95CI = c(cal_intercept_lower, cal_slope_lower),
  Upper_95CI = c(cal_intercept_upper, cal_slope_upper)
)

