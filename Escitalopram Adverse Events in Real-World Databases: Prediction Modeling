# 查看数据结构
str(data)
head(data)

# 3. 数据预处理 --------------------------------------------------------------

# 定义自杀相关PT
suicide_pt <- c("Completed suicide", "Suicide attempt", "Suicidal ideation", 
                "Suspected suicide", "Suicidal behaviour", "Depression suicidal")

# 创建目标变量: 1=自杀风险, 0=其他风险 (确保是数值型)
data$target <- as.numeric(ifelse(data$pt %in% suicide_pt, 1, 0))

# 查看类别分布
table(data$target)
prop.table(table(data$target))

# 筛选特征用于建模 (排除ID变量和目标相关变量)
features <- data %>%
  select(-c(primaryid, caseid, pt, target)) %>%
  # 将字符型变量转换为因子
  mutate(across(where(is.character), as.factor))

# 检查是否有缺失值
sum(is.na(features))

# 特征名称
feature_names <- names(features)

# 4. 数据平衡采样 (1:1) ------------------------------------------------------

# 获取自杀组和非自杀组索引
suicide_idx <- which(data$target == 1)
non_suicide_idx <- which(data$target == 0)

# 设置采样数量
n_suicide <- length(suicide_idx)
n_non_suicide <- length(non_suicide_idx)

cat("自杀组样本数:", n_suicide, "\n")
cat("非自杀组样本数:", n_non_suicide, "\n")

# 从非自杀组中随机抽取与自杀组相同数量的样本
set.seed(456)
sampled_non_suicide_idx <- sample(non_suicide_idx, size = n_suicide, replace = FALSE)

# 合并索引
balanced_idx <- c(suicide_idx, sampled_non_suicide_idx)

# 创建平衡数据集
balanced_data <- data[balanced_idx, ]
balanced_features <- features[balanced_idx, ]
balanced_target <- data$target[balanced_idx]  # 已经是数值型

# 检查平衡后的类别分布
table(balanced_target)

# 5. 划分训练集和测试集 (70/30) ---------------------------------------------

set.seed(789)
train_idx <- createDataPartition(balanced_target, p = 0.7, list = FALSE)

X_train <- balanced_features[train_idx, ]
X_test <- balanced_features[-train_idx, ]
y_train <- balanced_target[train_idx]
y_test <- balanced_target[-train_idx]

# 确保y_train和y_test是数值型
y_train <- as.numeric(y_train)
y_test <- as.numeric(y_test)

# 检查训练集分布
table(y_train)
table(y_test)

# 6. 特征工程 - 创建虚拟变量 ------------------------------------------------

# 对训练集进行one-hot编码
dummy_model <- dummyVars(~ ., data = X_train, fullRank = TRUE)
X_train_dummy <- predict(dummy_model, X_train)
X_test_dummy <- predict(dummy_model, X_test)

# 转换为数据框
X_train_df <- as.data.frame(X_train_dummy)
X_test_df <- as.data.frame(X_test_dummy)

# 移除零方差特征
nzv <- nearZeroVar(X_train_df)
if (length(nzv) > 0) {
  X_train_df <- X_train_df[, -nzv]
  X_test_df <- X_test_df[, -nzv]
}

# 确保所有列都是数值型
X_train_df <- as.data.frame(lapply(X_train_df, as.numeric))
X_test_df <- as.data.frame(lapply(X_test_df, as.numeric))

# 处理可能的NA值
X_train_df[is.na(X_train_df)] <- 0
X_test_df[is.na(X_test_df)] <- 0

# 转换为矩阵 (用于某些模型)
X_train_mat <- as.matrix(X_train_df)
X_test_mat <- as.matrix(X_test_df)

# 7. 模型训练与评估函数 -----------------------------------------------------

# 创建评估指标计算函数
calculate_metrics <- function(pred_prob, y_true, threshold = 0.5) {
  # 确保输入是数值型
  pred_prob <- as.numeric(pred_prob)
  y_true <- as.numeric(y_true)
  
  pred_class <- ifelse(pred_prob >= threshold, 1, 0)
  pred_class <- as.factor(pred_class)
  y_true_factor <- as.factor(y_true)
  
  # 混淆矩阵
  cm <- confusionMatrix(pred_class, y_true_factor)
  
  # ROC和AUC
  roc_obj <- roc(y_true, pred_prob)
  auc_value <- auc(roc_obj)
  
  # PR曲线
  pr_obj <- pr.curve(scores.class0 = pred_prob[y_true == 1], 
                     scores.class1 = pred_prob[y_true == 0], 
                     curve = TRUE)
  
  # 返回指标
  return(list(
    accuracy = cm$overall["Accuracy"],
    precision = cm$byClass["Precision"],
    recall = cm$byClass["Sensitivity"],
    f1 = cm$byClass["F1"],
    auc = as.numeric(auc_value),
    pr_auc = pr_obj$auc.integral,
    confusion_matrix = cm$table
  ))
}

# 8. 模型1: 随机森林 (RF) --------------------------------------------------

cat("\n========== 训练随机森林模型 ==========\n")

# 确保y_train是因子类型（randomForest要求）
y_train_factor <- as.factor(y_train)

rf_model <- randomForest(
  x = X_train_df,
  y = y_train_factor,
  ntree = 500,
  mtry = floor(sqrt(ncol(X_train_df))),
  importance = TRUE,
  nodesize = 5
)

# 预测
rf_pred_prob <- predict(rf_model, X_test_df, type = "prob")[, 2]
rf_metrics <- calculate_metrics(rf_pred_prob, y_test)

cat("随机森林评估结果:\n")
cat("Accuracy:", rf_metrics$accuracy, "\n")
cat("Precision:", rf_metrics$precision, "\n")
cat("Recall:", rf_metrics$recall, "\n")
cat("F1:", rf_metrics$f1, "\n")
cat("AUC:", rf_metrics$auc, "\n")
cat("PR-AUC:", rf_metrics$pr_auc, "\n")

# 9. 模型2: 梯度提升机 (GBM) ----------------------------------------------

cat("\n========== 训练GBM模型 ==========\n")

# 准备GBM数据
train_data_gbm <- cbind(X_train_df, y_train = y_train)

gbm_model <- gbm(
  formula = y_train ~ .,
  data = train_data_gbm,
  distribution = "bernoulli",
  n.trees = 500,
  interaction.depth = 3,
  n.minobsinnode = 5,
  shrinkage = 0.01,
  cv.folds = 5,
  verbose = FALSE
)

# 选择最优树数
best_trees <- gbm.perf(gbm_model, method = "cv", plot.it = FALSE)

# 预测
gbm_pred_prob <- predict(gbm_model, X_test_df, n.trees = best_trees, type = "response")
gbm_metrics <- calculate_metrics(gbm_pred_prob, y_test)

cat("GBM评估结果:\n")
cat("Accuracy:", gbm_metrics$accuracy, "\n")
cat("Precision:", gbm_metrics$precision, "\n")
cat("Recall:", gbm_metrics$recall, "\n")
cat("F1:", gbm_metrics$f1, "\n")
