# 12. 评估模型性能（增强版）---------------------------------------------------

calculate_metrics <- function(pred_prob, y_true, threshold = 0.5) {
  pred_class <- ifelse(pred_prob >= threshold, 1, 0)
  
  cm <- table(Predicted = pred_class, Actual = y_true)
  
  # 基础指标
  accuracy <- sum(diag(cm)) / sum(cm)
  precision <- ifelse(sum(pred_class == 1) > 0, cm[2,2] / sum(pred_class == 1), NA)
  recall <- ifelse(sum(y_true == 1) > 0, cm[2,2] / sum(y_true == 1), NA)
  specificity <- ifelse(sum(y_true == 0) > 0, cm[1,1] / sum(y_true == 0), NA)
  f1 <- ifelse(!is.na(precision) & !is.na(recall) & (precision + recall) > 0, 
               2 * precision * recall / (precision + recall), NA)
  
  # 额外指标（适用于平衡数据集）
  balanced_accuracy <- (recall + specificity) / 2
  mcc <- ifelse(sum(cm) > 0, {
    tp <- cm[2,2]; tn <- cm[1,1]; fp <- cm[2,1]; fn <- cm[1,2]
    (tp * tn - fp * fn) / sqrt((tp + fp) * (tp + fn) * (tn + fp) * (tn + fn))
  }, NA)
  
  # ROC和AUC
  roc_obj <- tryCatch({
    roc(y_true, pred_prob)
  }, error = function(e) NULL)
  
  auc_value <- ifelse(!is.null(roc_obj), as.numeric(auc(roc_obj)), NA)
  
  # 最优阈值（Youden指数）
  optimal_threshold <- ifelse(!is.null(roc_obj), {
    coords <- coords(roc_obj, "best", ret = "threshold", best.method = "youden")
    as.numeric(coords)
  }, NA)
  
  return(list(
    accuracy = accuracy,
    precision = precision,
    recall = recall,
    specificity = specificity,
    f1 = f1,
    balanced_accuracy = balanced_accuracy,
    mcc = mcc,
    auc = auc_value,
    optimal_threshold = optimal_threshold,
    confusion_matrix = cm,
    roc_obj = roc_obj
  ))
}

