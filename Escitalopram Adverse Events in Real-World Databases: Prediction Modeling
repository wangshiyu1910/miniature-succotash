# ---------- 3. 重复交叉验证（反映模型选择层面的不确定性） ----------
# 在训练集上做 5 折 × 10 次重复，每次重复内重新训练六个模型并记录 AUC
suppressPackageStartupMessages({ library(caret); library(randomForest)
  library(gbm); library(e1071); library(xgboost); library(glmnet); library(rpart) })

run_repeated_cv <- function(X_train_df, y_train, X_train_mat, X_train_scaled,
                            repeats = 10, folds = 5, seed = 2024) {
  set.seed(seed)
  # 统一折划分，保证六个模型在同一折上比较
  folds_list <- createMultiFolds(as.factor(y_train), k = folds, times = repeats)
  model_names_cv <- c("RF","GBM","SVM","XGBoost","ElasticNet","DecisionTree")
  res <- matrix(NA, nrow = length(folds_list), ncol = length(model_names_cv),
                dimnames = list(NULL, model_names_cv))
  
  for (i in seq_along(folds_list)) {
    tr <- folds_list[[i]]; te <- setdiff(seq_along(y_train), tr)
    Xtr <- X_train_df[tr, , drop = FALSE]; Xte <- X_train_df[te, , drop = FALSE]
    ytr <- y_train[tr]; yte <- y_train[te]
    
    # RF
    rf <- randomForest(x = Xtr, y = as.factor(ytr), ntree = 500,
                       mtry = floor(sqrt(ncol(Xtr))), nodesize = 5)
    res[i, "RF"] <- as.numeric(auc(roc(yte, predict(rf, Xte, type = "prob")[, 2], quiet = TRUE)))
    
    # GBM
    gbm_df <- cbind(Xtr, y_train = ytr)
    gb <- gbm(y_train ~ ., data = gbm_df, distribution = "bernoulli",
              n.trees = 500, interaction.depth = 3, n.minobsinnode = 5,
              shrinkage = 0.01, cv.folds = 5, verbose = FALSE)
    bt <- gbm.perf(gb, method = "cv", plot.it = FALSE)
    res[i, "GBM"] <- as.numeric(auc(roc(yte, predict(gb, Xte, n.trees = bt, type = "response"), quiet = TRUE)))
    
    # SVM
    sv <- svm(x = Xtr, y = as.factor(ytr), kernel = "radial", probability = TRUE,
              cost = 1, gamma = 1/ncol(Xtr))
    svp <- attr(predict(sv, Xte, probability = TRUE), "probabilities")[, "1"]
    res[i, "SVM"] <- as.numeric(auc(roc(yte, svp, quiet = TRUE)))
    
    # XGBoost
    dtrain_cv <- xgb.DMatrix(data = as.matrix(Xtr), label = ytr)
    dtest_cv <- xgb.DMatrix(data = as.matrix(Xte), label = yte)
    xg <- xgb.train(params = list(objective = "binary:logistic", eval_metric = "auc",
                                  max_depth = 6, eta = 0.1, subsample = 0.8,
                                  colsample_bytree = 0.8, min_child_weight = 1),
                    data = dtrain_cv, nrounds = 100, verbose = 0)
    res[i, "XGBoost"] <- as.numeric(auc(roc(yte, predict(xg, dtest_cv), quiet = TRUE)))
    
    # ElasticNet
    pre <- preProcess(Xtr, method = c("center","scale"))
    Xtr_s <- as.matrix(predict(pre, Xtr)); Xte_s <- as.matrix(predict(pre, Xte))
    cvgl <- cv.glmnet(x = Xtr_s, y = ytr, family = "binomial", alpha = 0.5, nfolds = 5)
    res[i, "ElasticNet"] <- as.numeric(auc(roc(yte,
                                               predict(cvgl, Xte_s, s = cvgl$lambda.min, type = "response")[, 1], quiet = TRUE)))
    
    # DecisionTree
    rp <- rpart(as.factor(ytr) ~ ., data = as.data.frame(Xtr_s), method = "class",
                cp = 0.01, minsplit = 20)
    rp <- prune(rp, cp = rp$cptable[which.min(rp$cptable[, "xerror"]), "CP"])
    rp_prob <- predict(rp, as.data.frame(Xte_s), type = "prob")[, 2]
    res[i, "DecisionTree"] <- as.numeric(auc(roc(yte, rp_prob, quiet = TRUE)))
  }
  res
}

